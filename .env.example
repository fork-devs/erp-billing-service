# ==============================================================================
# ERP BILLING SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Este fichero declara los NOMBRES de las variables, nunca sus valores en producción.
# Ningún secreto real se escribe aquí: se resuelve por variable de entorno o por
# el almacén de secretos (Azure Key Vault / Secret Manager).
# ==============================================================================

# Server configuration (puerto donde escucha erp-billing-service)
SERVER_PORT=8086

# Spring profiles (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Database configuration (PostgreSQL erp_billing_db)
#
# SPRING_DATASOURCE_USERNAME es el rol de EJECUCIÓN de la app: no es propietario
# de las tablas para que PostgreSQL fuerce las políticas de Row-Level Security (RLS).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/erp_billing_db
SPRING_DATASOURCE_USERNAME=erp_billing_app
SPRING_DATASOURCE_PASSWORD=

# Rol PROPIETARIO: lo usa únicamente Flyway para ejecutar las migraciones DDL.
SPRING_FLYWAY_USER=erp_billing_owner
SPRING_FLYWAY_PASSWORD=

# Contraseña del rol de ejecución de la BD para la migración Flyway
ERP_APP_DB_PASSWORD=

# Auth Service JWKS URL
# Publicado en /.well-known/jwks.json para verificación asimétrica RS256 de JWTs.
JWKS_URL=https://auth.erp-automotriz.com/.well-known/jwks.json

# Factos Fiscal Service (MockAPI de Facturación Electrónica CPE SUNAT)
FACTOS_BASE_URL=https://factos-reva.onrender.com
FACTOS_API_KEY=

# RUC Emisor por defecto para la facturación del taller
ERP_BILLING_ISSUER_RUC=20123456789

# Transactional Outbox Relay Configuration
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=7
